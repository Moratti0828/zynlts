# This file contains examples, not working credentials.
# init_env.py creates .env with a cryptographically random access token.
READING_BENCH_TOKEN=
APP_HOST_BIND=127.0.0.1
APP_PORT=8787
READING_BENCH_OLLAMA_URL=http://ollama:11434
# Bootstrap tags are mutable. After validation, replace with image@sha256:digest.
PYTHON_IMAGE=python:3.11-slim
OLLAMA_IMAGE=ollama/ollama:latest
# Optional: if a model entry uses api_key_env=READING_BENCH_REMOTE_KEY,
# add READING_BENCH_REMOTE_KEY=your-key to .env on the server only.

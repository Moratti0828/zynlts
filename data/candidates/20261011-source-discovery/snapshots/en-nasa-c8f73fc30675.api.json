om bg-carbon-black minh-mobile\">\n\t\t\t\t\t\t\t\t<figure class=\"hds-media-background  \"><img decoding=\"async\" width=\"300\" height=\"221\" src=\"https://www.nasa.gov/wp-content/uploads/2024/09/sspicy-landscape.png?w=300\" class=\"attachment-medium size-medium\" alt=\"\" style=\"transform: scale(1); transform-origin: 50% 50%; object-position: 50% 50%; object-fit: cover;\" block_context=\"nasa-block\" loading=\"lazy\" srcset=\"https://www.nasa.gov/wp-content/uploads/2024/09/sspicy-landscape.png 1353w, https://www.nasa.gov/wp-content/uploads/2024/09/sspicy-landscape.png?resize=300,221 300w, https://www.nasa.gov/wp-content/uploads/2024/09/sspicy-landscape.png?resize=768,565 768w, https://www.nasa.gov/wp-content/uploads/2024/09/sspicy-landscape.png?resize=1024,754 1024w, https://www.nasa.gov/wp-content/uploads/2024/09/sspicy-landscape.png?resize=400,294 400w, https://www.nasa.gov/wp-content/uploads/2024/09/sspicy-landscape.png?resize=600,442 600w, https://www.nasa.gov/wp-content/uploads/2024/09/sspicy-landscape.png?resize=900,663 900w, https://www.nasa.gov/wp-content/uploads/2024/09/sspicy-landscape.png?resize=1200,883 1200w\" sizes=\"auto, (max-width: 300px) 100vw, 300px\" /></figure>\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class=\"padding-right-0 desktop:padding-right-10\">\n\t\t\t\t\t\t\t\t<div class=\"subheading margin-bottom-1\">4 min read</div>\n\t\t\t\t\t\t\t\t<div class=\"margin-bottom-1\"><h3 class=\"related-article-title\">Getting SSPICY: NASA Funds Orbital Debris Inspection Mission</h3></div>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<div class=\"display-flex flex-align-center label related-article-label margin-bottom-1 color-carbon-60\">\n\t\t\t\t\t\t\t\t\t<span class=\"display-flex flex-align-center margin-right-2\">\n\t\t\t\t\t\t\t\t\t\t<svg version=\"1.1\" class=\"square-2 margin-right-1\" xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\" x=\"0px\" y=\"0px\" width=\"16px\" height=\"16px\" viewBox=\"0 0 1